<html lang="es">
 <head><script src="/_sdk/telemetry_sdk.js"></script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quiz Acuerdo 001 de 2024</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;700&amp;display=swap" rel="stylesheet">
  <style>
        body { font-family: 'Kanit', sans-serif; background: linear-gradient(135deg, #154361 0%, #EC6608 100%); }
        h1, h2 { font-family: 'Kanit', sans-serif; font-weight: 700; color: #ffffff; }
        p { color: #ffffff; }
        .opt-btn { transition: all 0.2s; background: #ffffff !important; color: #154361 !important; border: 2px solid #EC6608 !important; }
        .opt-btn:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(236, 102, 8, 0.3); background: #f3932b !important; color: #ffffff !important; }
        .opt-btn:disabled { cursor: not-allowed; opacity: 0.8; }
        .correct { background: #209079 !important; color: #ffffff !important; border-color: #209079 !important; }
        .incorrect { background: #f25c54 !important; color: #ffffff !important; border-color: #f25c54 !important; }
        .bg-white { background: #ffffff !important; }
        #progress-text, #score-text { color: #154361 !important; }
        #next-btn { background: #EC6608 !important; color: #ffffff !important; }
        #next-btn:hover { background: #154361 !important; }
        #feedback { font-family: 'Kanit', sans-serif; }
    </style>
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.263.0/dist/umd/lucide.min.js" type="text/javascript"></script>
  <script src="/_sdk/data_sdk.js" type="text/javascript"></script>
  <script src="/_sdk/resizing_sdk.js" type="text/javascript"></script>
 </head>
 <body data-template-id="__page-root" class="min-h-screen" style="background: linear-gradient(135deg, #154361 0%, #EC6608 100%)">
  <main class="max-w-2xl mx-auto px-4 py-8">
   <header class="text-center mb-8"><img data-template-id="hero-img" class="canva-image w-full h-48 object-cover rounded-xl mb-6" loading="lazy">
    <h1 data-template-id="quiz-title" class="canva-text text-3xl font-bold mb-2"></h1>
    <p data-template-id="quiz-subtitle" class="canva-text"></p>
   </header><!-- Progress -->
   <div class="mb-6">
    <div class="flex justify-between text-sm mb-1"><span id="progress-text" class="font-medium" style="color: #154361;">Pregunta 1 de 8</span> <span id="score-text" class="font-medium" style="color: #154361;">0 correctas</span>
    </div>
    <div class="w-full h-2 bg-gray-400 rounded-full overflow-hidden">
     <div id="progress-bar" class="h-full bg-gradient-to-r from-orange-500 to-blue-700 rounded-full transition-all duration-300" style="width:12.5%"></div>
    </div>
   </div><!-- Questions container -->
   <div id="questions-container"></div><!-- Result screen -->
   <div id="result-screen" class="hidden text-center py-12">
    <div class="text-6xl mb-4">
     🏆
    </div>
    <h2 data-template-id="result-title" class="canva-text text-2xl font-bold mb-2"></h2>
    <p id="result-score" class="text-xl text-gray-800 mb-6"></p><button data-template-id="restart-btn" class="canva-button px-6 py-3 rounded-lg font-semibold bg-orange-600 hover:bg-orange-700 text-white" onclick="restart()"></button>
   </div>
  </main>
  <script src="/_sdk/editing_sdk.js"></script>
  <script>
        const questions = [
            { q: "¿Qué entidad expidió el Acuerdo 001 de 2024?", opts: ["Ministerio de Educación", "Archivo General de la Nación", "Contraloría General", "DAFP"], correct: 1, explain: "Fue expedido por el Archivo General de la Nación." },
            { q: "¿Cuál es el objetivo principal del Acuerdo 001 de 2024?", opts: ["Regular la contratación pública", "Fortalecer la gestión documental", "Definir políticas de TI", "Establecer normas contables"], correct: 1, explain: "Establece lineamientos para fortalecer la organización, administración, conservación y control de archivos." },
            { q: "¿Desde qué fecha rige el Acuerdo 001 de 2024?", opts: ["1 de enero de 2024", "29 de febrero de 2024", "15 de marzo de 2024", "1 de julio de 2024"], correct: 1, explain: "Rige desde el 29 de febrero de 2024." },
            { q: "¿Cuántos títulos componen el Acuerdo 001 de 2024?", opts: ["5 títulos", "8 títulos", "10 títulos", "12 títulos"], correct: 2, explain: "El Acuerdo está estructurado en 10 títulos." },
            { q: "¿A quién aplica este Acuerdo?", opts: ["Solo a archivos nacionales", "Solo a empresas privadas", "Entidades públicas y sujetos obligados", "Solo a universidades"], correct: 2, explain: "Aplica a entidades públicas de todos los niveles y demás sujetos obligados." },
            { q: "¿Qué regula el Título 1 del Acuerdo?", opts: ["Patrimonio Documental", "Disposiciones Generales", "Valoración Documental", "Acceso y Consulta"], correct: 1, explain: "El Título 1 trata las Disposiciones Generales: objeto, ámbito, planeación y responsabilidades." },
            { q: "¿Qué órgano asesora al AGN según el Título 2?", opts: ["Comité de Convivencia", "Comité Evaluador de Documentos", "Junta Directiva", "Consejo Académico"], correct: 1, explain: "El Comité Evaluador de Documentos asesora al AGN en valoración, retención y declaratoria de bienes de interés cultural." },
            { q: "¿Quiénes son responsables de la gestión documental en una entidad?", opts: ["Solo el área de archivo", "Solo los directivos", "Todos los servidores, contratistas y colaboradores", "Solo el área jurídica"], correct: 2, explain: "Cada servidor, contratista y colaborador participa en la producción, recepción y uso de documentos." }
        ];

        let current = 0, score = 0, answered = false;

        function render() {
            const container = document.getElementById('questions-container');
            container.innerHTML = '';
            const q = questions[current];
            const div = document.createElement('div');
            div.className = 'bg-white rounded-xl p-6 shadow-md';
            div.innerHTML = `
                <p class="font-semibold text-lg mb-4" style="color: #154361;">${q.q}</p>
                <div class="space-y-3" id="opts"></div>
                <p id="feedback" class="mt-4 text-sm font-medium hidden"></p>
                <button id="next-btn" class="mt-5 w-full py-3 text-white font-semibold rounded-lg hidden transition" style="background: #EC6608;">Siguiente</button>
            `;
            container.appendChild(div);
            const optsDiv = div.querySelector('#opts');
            q.opts.forEach((opt, i) => {
                const btn = document.createElement('button');
                btn.className = 'opt-btn w-full text-left px-4 py-3 border-2 rounded-lg font-medium';
                btn.textContent = opt;
                btn.onclick = () => answer(i);
                optsDiv.appendChild(btn);
            });
        }

        function answer(idx) {
            if (answered) return;
            answered = true;
            const q = questions[current];
            const btns = document.querySelectorAll('.opt-btn');
            btns.forEach((b, i) => {
                b.disabled = true;
                if (i === q.correct) b.classList.add('correct');
                if (i === idx && idx !== q.correct) b.classList.add('incorrect');
            });
            if (idx === q.correct) score++;
            const fb = document.getElementById('feedback');
            fb.textContent = idx === q.correct ? `✓ ¡Correcto! ${q.explain}` : `✗ Incorrecto. ${q.explain}`;
            fb.className = `mt-4 text-sm font-medium ${idx === q.correct ? 'text-emerald-100' : 'text-red-100'}`;
            fb.classList.remove('hidden');
            document.getElementById('next-btn').classList.remove('hidden');
            document.getElementById('score-text').textContent = `${score} correctas`;
        }

        function next() {
            current++;
            answered = false;
            if (current >= questions.length) {
                document.getElementById('questions-container').classList.add('hidden');
                document.getElementById('result-screen').classList.remove('hidden');
                document.getElementById('result-score').textContent = `Obtuviste ${score} de ${questions.length} respuestas correctas.`;
            } else {
                document.getElementById('progress-text').textContent = `Pregunta ${current+1} de ${questions.length}`;
                document.getElementById('progress-bar').style.width = `${((current+1)/questions.length)*100}%`;
                render();
            }
        }

        function restart() {
            current = 0; score = 0; answered = false;
            document.getElementById('questions-container').classList.remove('hidden');
            document.getElementById('result-screen').classList.add('hidden');
            document.getElementById('progress-text').textContent = 'Pregunta 1 de 8';
            document.getElementById('progress-bar').style.width = '12.5%';
            document.getElementById('score-text').textContent = '0 correctas';
            render();
        }

        render();
    </script>
